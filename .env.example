# Copy to .env and adjust
STALLION_TOKEN=change-me-to-a-long-random-string
MEDIA_DIR=./media
# Owner of MEDIA_DIR, so converted files belong to you
PUID=1000
PGID=1000
# GPU encoding on Intel/AMD: STALLION_VAAPI=1, the group of the render device
# (`stat -c %g /dev/dri/renderD128`), and uncomment `devices` in compose.yaml
STALLION_VAAPI=0
RENDER_GID=107
